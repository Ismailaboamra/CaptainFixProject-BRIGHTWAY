  {
    "id": "TC-044",
    "description": "### Test Case 7: User Login"
  },
  {
    "id": "TC-045",
    "description": "**Objective:** Validate the user login functionality."
  },
  {
    "id": "TC-046",
    "description": "**Steps:**"
  },
  {
    "id": "TC-047",
    "description": "1. Click on the \"Sign in\" button."
  },
  {
    "id": "TC-048",
    "description": "2. Enter valid credentials (username and password)."
  },
  {
    "id": "TC-049",
    "description": "3. Click on the \"Sign in\" button."
  },
  {
    "id": "TC-050",
    "description": "**Expected Result:** The user should be logged in successfully and redirected to their account page."
  },
  {
    "id": "TC-051",
    "description": "---"
  },
  {
    "id": "TC-052",
    "description": "### Test Case 8: User Registration"
  },
  {
    "id": "TC-053",
    "description": "**Objective:** Test the user registration process."
  },
  {
    "id": "TC-054",
    "description": "**Steps:**"
  },
  {
    "id": "TC-055",
    "description": "1. Click on the \"Register\" button."
  },
  {
    "id": "TC-056",
    "description": "2. Fill in the required fields (name, email, password, etc.)."
  },
  {
    "id": "TC-057",
    "description": "3. Submit the registration form."
  },
  {
    "id": "TC-058",
    "description": "**Expected Result:** The user should be registered successfully and receive a confirmation email."
  },
  {
    "id": "TC-059",
    "description": "---"
  },
  {
    "id": "TC-060",
    "description": "### Test Case 9: Password Recovery"
  },
  {
    "id": "TC-061",
    "description": "**Objective:** Verify the password recovery functionality."
